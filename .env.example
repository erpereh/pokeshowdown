# ============================================================
# PokeShowdown - Environment variables
# Copia este archivo como .env.local y rellena los valores.
# Nunca subas credenciales reales al repositorio.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL WebSocket publica que utilizara el frontend.
NEXT_PUBLIC_GAME_SERVER_WS_URL=ws://localhost:3001/ws

# ------------------------------------------------------------
# Supabase - valores publicos para el cliente
# ------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# ------------------------------------------------------------
# Supabase - SOLO servidor
# ------------------------------------------------------------

# Nunca usar esta variable en codigo cliente ni renombrarla con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Conexion PostgreSQL para tooling/migraciones/ORM si se necesita acceso directo.
# Puede dejarse sin usar hasta que exista una capa SQL que la necesite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# Conexion directa opcional para migraciones que no deban pasar por pooler.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ------------------------------------------------------------
# Game server
# ------------------------------------------------------------

GAME_SERVER_HOST=0.0.0.0
GAME_SERVER_PORT=3001

# URL del frontend permitida inicialmente por el game server.
WEB_APP_ORIGIN=http://localhost:3000

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

NODE_ENV=development
